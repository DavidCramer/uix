{
    "name": "desertsnowman/uix",
    "description": "React-based UI framework for WordPress Plugins",
    "type": "wordpress-framework",
    "keywords": ["wordpress", "UI", "framework", "react", "gutenberg"],
    "license": "GPL-2.0+",
    "authors": [
        {
            "name": "David Cramer",
            "homepage": "http://cramer.co.za",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "UIX\\": "src/"
        },
        "files": ["uix-bootstrap.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "UIX\\Tests\\": "tests/"
        }
    }
}
